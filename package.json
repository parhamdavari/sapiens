{
  "name": "sapiens-skill",
  "version": "3.5.0",
  "description": "A Claude skill that makes replies read like a person wrote them: plain, complete, unpadded English, built for readers whose first language isn't English.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "measure": "node scripts/measure.mjs",
    "package": "node scripts/package.mjs",
    "render": "node scripts/render-assets.mjs",
    "test": "npm run validate && npm run self-check && npm run test:unit",
    "self-check": "node scripts/self-check.mjs",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent-skill",
    "skill",
    "plain-language",
    "esl",
    "readability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/parhamdavari/sapiens.git"
  }
}
